{
  "name": "modelscope-copilot-chat",
  "displayName": "ModelScope for Copilot Chat",
  "description": "Chat with ModelScope models in GitHub Copilot Chat, with ModelScope Magicube balance and request quota in the status bar.",
  "version": "0.7.10",
  "publisher": "ltmoerdani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M-Kepler/modelscope-copilot-chat"
  },
  "homepage": "https://github.com/M-Kepler/modelscope-copilot-chat#readme",
  "bugs": {
    "url": "https://github.com/M-Kepler/modelscope-copilot-chat/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ModelScope",
    "Magicube",
    "Copilot Chat",
    "language model"
  ],
  "icon": "media/modelscope.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:modelscopecn",
    "onLanguageModelChatProvider:modelscopeglobal"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "modelscopecn",
        "displayName": "ModelScope China",
        "managementCommand": "modelscope.cn.manage",
        "when": "config.modelscope.enabled"
      },
      {
        "vendor": "modelscopeglobal",
        "displayName": "ModelScope Global",
        "managementCommand": "modelscope.global.manage",
        "when": "config.modelscope.enabled"
      },
      {
        "vendor": "modelscopecn-agent",
        "displayName": "ModelScope China",
        "managementCommand": "modelscope.cn.manage",
        "when": "config.modelscope.enabled && config.modelscope.agentsWindow"
      },
      {
        "vendor": "modelscopeglobal-agent",
        "displayName": "ModelScope Global",
        "managementCommand": "modelscope.global.manage",
        "when": "config.modelscope.enabled && config.modelscope.agentsWindow"
      }
    ],
    "commands": [
      {
        "command": "modelscope.cn.manage",
        "title": "ModelScope China: Manage"
      },
      {
        "command": "modelscope.global.manage",
        "title": "ModelScope Global: Manage"
      },
      {
        "command": "modelscope.refreshModels",
        "title": "ModelScope: Refresh Models"
      },
      {
        "command": "modelscope.diagnostics",
        "title": "ModelScope: Show Diagnostics"
      },
      {
        "command": "modelscope.modelPickerDiagnostics",
        "title": "ModelScope: Diagnose Model Picker"
      },
      {
        "command": "modelscope.setThinkingEffort",
        "title": "ModelScope: Set Thinking Effort"
      },
      {
        "command": "modelscope.refreshMagicubeBalance",
        "title": "ModelScope: Refresh Magicube Balance"
      }
    ],
    "configuration": {
      "title": "ModelScope",
      "properties": {
        "modelscope.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ModelScope chat providers."
        },
        "modelscope.agentsWindow": {
          "type": "boolean",
          "default": true,
          "description": "Register ModelScope providers in the VS Code Agents window."
        },
        "modelscope.showProviderPrefix": {
          "type": "boolean",
          "default": false,
          "description": "Show the provider name before model names."
        },
        "modelscope.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for chat requests."
        },
        "modelscope.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Override the maximum output token count; 0 uses the model default."
        },
        "modelscope.maxInputTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Override the maximum input token count; 0 uses the model default."
        },
        "modelscope.debugReasoning": {
          "type": "boolean",
          "default": false,
          "description": "Write reasoning diagnostics to the extension output channel."
        },
        "modelscope.requestTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 1,
          "maximum": 1800,
          "description": "Maximum duration of a chat request in seconds."
        },
        "modelscope.streamIdleTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "maximum": 600,
          "description": "Maximum time without streamed output before a request times out."
        },
        "modelscope.stripThinkTags": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "Control whether reasoning tags are removed from model output."
        },
        "modelscope.thinking.deepseek": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "high",
            "max"
          ],
          "default": "off"
        },
        "modelscope.thinking.glm": {
          "type": "string",
          "enum": [
            "off",
            "high",
            "max"
          ],
          "default": "off"
        },
        "modelscope.thinking.kimi": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "default": "off"
        },
        "modelscope.thinking.minimax": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ],
          "default": "off"
        },
        "modelscope.thinking.openai": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "off"
        },
        "modelscope.thinking.qwen": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto"
        },
        "modelscope.thinking.qwenBudget": {
          "type": "string",
          "enum": [
            "auto",
            "4096",
            "16384",
            "32768",
            "81920"
          ],
          "default": "auto"
        },
        "modelscope.thinking.mimo": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "high"
          ],
          "default": "off"
        },
        "modelscope.thinking.muse": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "off"
        },
        "modelscope.thinking.gemini": {
          "type": "string",
          "enum": [
            "off",
            "on",
            "low",
            "medium",
            "high"
          ],
          "default": "off"
        },
        "modelscope.thinking.generic": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "off"
        }
      }
    }
  },
  "scripts": {
    "lint": "tsx scripts/lint.ts",
    "lint:staged": "tsx scripts/staged-lint.ts",
    "lint:js": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:md": "markdownlint-cli2 --config .markdownlint-cli2.json \"**/*.md\" \"#node_modules\"",
    "lint:md:all": "markdownlint-cli2 --config .markdownlint-cli2.json \"**/*.md\"",
    "lint:sh": "shellcheck .husky/pre-commit",
    "lint:hygiene": "editorconfig-checker",
    "lint:ts": "tsc -p tsconfig.check.json",
    "format": "tsx scripts/format.ts",
    "format:js": "eslint . --fix --max-warnings 0",
    "format:prettier": "npx prettier --write . --ignore-path .gitignore",
    "format:check": "npx prettier --check . --ignore-path .gitignore",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "test": "npm run compile && tsx scripts/run-unit-tests.ts",
    "watch": "npm run clean && tsc -watch -p ./",
    "test-retry": "tsx scripts/test-retry-e2e.ts",
    "prepackage": "npm test",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "*.{js,cjs,ts}": "eslint --max-warnings 0",
    "*.md": "markdownlint-cli2 --config .markdownlint-cli2.json",
    ".husky/*": "shellcheck"
  },
  "dependencies": {
    "@silvia-odwyer/photon-node": "^0.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "editorconfig-checker": "^6.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-yml": "^3.8.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.6",
    "shellcheck": "^4.1.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
